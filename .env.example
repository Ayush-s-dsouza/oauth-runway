# Required for live guide generation
ANTHROPIC_API_KEY=
# Optional: enables the Composio catalog lookup (managed-auth status, default scopes, authorize URLs)
COMPOSIO_API_KEY=
# Optional tuning
RESEARCH_MODEL=claude-haiku-5-5
SYNTHESIS_MODEL=claude-opus-5-5
# Harness steering (defaults = the configuration the eval selected; see DECISIONS.md)
COVERAGE_GATE=1
RESEARCH_PLAN=1
EVIDENCE_LOCK=quote
AGENT_EFFORT=medium
AGENT_MAX_SECONDS=480
RATE_LIMIT_PER_MIN=3
GENERATION_DAILY_CAP=40
DATA_DIR=./data
REPO_URL=
