{
  "flow": "oauth-guide",
  "description": "Generate an OAuth app setup/approval guide for one app (app.pipeline.generate_guide).",
  "metrics": [
    {"id": "fact_recall", "label": "fact recall", "kind": "judge", "scale": 1},
    {"id": "quote_support", "label": "quote support", "kind": "judge", "scale": 1},
    {"id": "grounded_rate", "label": "grounded", "kind": "float", "scale": 1},
    {"id": "supported_steps", "label": "steps sourced", "kind": "float", "scale": 1},
    {"id": "managed_match", "label": "managed match", "kind": "float", "scale": 1},
    {"id": "probed", "label": "probed", "kind": "float", "scale": 1},
    {"id": "difficulty_dist", "label": "difficulty dist", "kind": "float", "scale": 3, "better": "lower"},
    {"id": "edge_pass", "label": "edge pass", "kind": "judge", "scale": 1}
  ],
  "perf_fields": [
    {"id": "cost_usd", "label": "cost", "unit": "$"},
    {"id": "judge_cost_usd", "label": "judge cost", "unit": "$"},
    {"id": "latency_s", "label": "latency", "unit": "s"},
    {"id": "sources", "label": "sources"},
    {"id": "probes", "label": "probes"},
    {"id": "escalated", "label": "escalated"}
  ],
  "harness_paths": [
    "evals/run.py", "evals/grade.py", "evals/judge.py", "evals/cases.json",
    "app/agent.py", "app/prompts.py", "app/pipeline.py", "app/validate.py",
    "app/schema.py", "app/probes.py", "app/composio_lookup.py", "app/render_md.py"
  ]
}
